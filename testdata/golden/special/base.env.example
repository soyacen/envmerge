# Quoted values keep their quotes
GREETING="hello world"
SINGLE='hello world'
# Value containing an equals sign and a hash
CONNECTION="mysql://root:pass#1@localhost:3306/db?opt=1"
EMPTY=
# Inline comment after value
PORT=8080 # the port
# Variable references are NOT expanded
APP_HOST=localhost
APP_PORT=8080
APP_URL=http://${APP_HOST}:${APP_PORT}
