# Application
APP_NAME=muonflow
APP_ENV=development
APP_DEBUG=true
APP_TIMEZONE=UTC

# Logging
# Override
LOG_LEVEL=debug
LOG_FORMAT=json

# MySQL
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=muonflow
DB_MAX_OPEN_CONNS=100
DB_MAX_IDLE_CONNS=10

# Redis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# HTTP Server
HTTP_HOST=0.0.0.0
HTTP_PORT=8080
HTTP_READ_TIMEOUT=30s
HTTP_WRITE_TIMEOUT=30s
